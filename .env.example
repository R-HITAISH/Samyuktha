# SAMYUKTA — Intelligent Hybrid Weather Forecast Fusion
# Environment Configuration Template

# Database
DATABASE_URL=sqlite:///data/samyukta.db
# For PostgreSQL production:
# DATABASE_URL=postgresql://user:password@localhost:5432/samyukta

# API
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_MAP_STYLE=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json

# Demo Mode
DEMO_MODE=true
DATA_MODE=DEMO

# Security
SECRET_KEY=change-this-in-production
API_KEY=samyukta-dev-key

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/samyukta.log

# ML
MODEL_DIR=models/
CONFIG_PATH=configs/settings.yaml
TORCH_DEVICE=cpu
