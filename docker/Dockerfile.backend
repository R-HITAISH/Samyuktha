FROM python:3.11-slim

WORKDIR /app

# System deps
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy source
COPY backend/ ./backend/
COPY ml/ ./ml/
COPY configs/ ./configs/
COPY scripts/ ./scripts/

# Create data dirs
RUN mkdir -p data/demo data/processed models logs

# Generate demo data on build
RUN python -c "import sys; sys.path.insert(0,'.'); from ml.ingestion.synthetic_generator import generate_demo_dataset; generate_demo_dataset('data/demo', n_days=90, start_date='2024-06-01', resolution=0.5)"

EXPOSE 8000

CMD ["python", "-m", "uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000"]
